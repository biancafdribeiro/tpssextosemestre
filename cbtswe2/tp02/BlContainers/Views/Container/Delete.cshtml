@model Container
@{ ViewData["Title"] = "Excluir Container"; }
<h2>Excluir Container</h2>
<div class="alert alert-warning">Tem certeza que deseja excluir o container <strong>@Model.Numero</strong> (BL @Model.BL?.Numero)?</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="
btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
