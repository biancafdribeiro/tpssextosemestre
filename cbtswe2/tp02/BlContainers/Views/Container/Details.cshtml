@model Container
@{ ViewData["Title"] = "Detalhes do Container"; }
<h2>Container @Model.Numero</h2>
<div class="card shadow-sm mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.ID</dd>
        <dt class="col-sm-3">Número</dt><dd class="col-sm-9">@Model.Numero</dd>
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd>
        <dt class="col-sm-3">Tamanho</dt><dd class="col-sm-9">@Model.Tamanho'</dd>
        <dt class="col-sm-3">BL</dt><dd class="col-sm-9">@Model.BL?.Numero</dd>
    </dl>
</div></div>
<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
