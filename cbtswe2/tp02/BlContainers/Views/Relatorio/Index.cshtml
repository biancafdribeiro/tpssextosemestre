@model IEnumerable<BL>
@{ ViewData["Title"] = "Relatório"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Relatório de BLs e Containers</h2>
    <button class="btn btn-outline-dark d-print-none" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
</div>
@foreach (var b in Model)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white">
            <strong>BL @b.Numero</strong>
            <span class="text-muted ms-3">Consignee: @b.Consignee</span>
            <span class="text-muted ms-3">Navio: @b.Navio</span>
            <span class="badge bg-primary float-end">@b.Containers.Count container(s)</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Container</th><th>Tipo</th><th>Tamanho</th></tr></thead>
                <tbody>
                @foreach (var c in b.Containers.OrderBy(x => x.Numero))
                {
                    <tr><td>@c.Numero</td><td>@c.Tipo</td><td>@c.Tamanho'</td></tr>
                }
                @if (!b.Containers.Any()) { <tr><td colspan="3" class="text-muted text-center">Sem containers.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
}
@if (!Model.Any()) { <p class="text-muted">Nenhum BL cadastrado.</p> }
