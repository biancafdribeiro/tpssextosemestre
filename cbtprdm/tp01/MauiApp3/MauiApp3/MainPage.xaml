<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp3.MainPage"
    BackgroundColor="LightPink">

    <VerticalStackLayout Padding="25" Spacing="15">

        <Label
            Text="Aplicação Teste"
            TextColor="DeepPink"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,0,0,30" />

        <Grid ColumnDefinitions="Auto,*">

            <Label
                Text="ID"
                TextColor="DeepPink"
                FontSize="22"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Entry
                x:Name="txtId"
                Grid.Column="1"
                TextColor="White"
                BackgroundColor="Transparent"
                FontSize="18"
                Margin="15,0,0,0" />

        </Grid>

        <Grid ColumnDefinitions="Auto,*">

            <Label
                Text="Pass"
                TextColor="DeepPink"
                FontSize="22"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Entry
                x:Name="txtSenha"
                Grid.Column="1"
                TextColor="White"
                BackgroundColor="Transparent"
                FontSize="18"
                IsPassword="True"
                Margin="15,0,0,0" />

        </Grid>

        <BoxView
            HeightRequest="80"
            BackgroundColor="Transparent" />

        <Button
            Text="OK"
            Clicked="BtnOk_Clicked"
            BackgroundColor="LightGray"
            TextColor="Black"
            FontSize="25"
            FontAttributes="Bold" />

        <Button
            Text="Limpar"
            Clicked="BtnLimpar_Clicked"
            BackgroundColor="LightGray"
            TextColor="Black"
            FontSize="25"
            FontAttributes="Bold" />

        <Button
            Text="Créditos"
            Clicked="BtnCreditos_Clicked"
            BackgroundColor="LightGray"
            TextColor="Black"
            FontSize="25"
            FontAttributes="Bold" />

    </VerticalStackLayout>

</ContentPage>